MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/department-cms?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ImageKit — server-only secrets (never prefix with NEXT_PUBLIC_)
# Get keys from: ImageKit Dashboard → Developer options → API keys
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

NEXT_PUBLIC_APP_URL=http://localhost:5000

# Used once to seed production users via POST /api/setup/seed
SETUP_SECRET=change_me_to_a_long_random_string

# Seed defaults (optional — change after first login)
SEED_SUPER_ADMIN_EMAIL=superadmin@university.edu
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_ADMIN_EMAIL=admin@university.edu
SEED_ADMIN_PASSWORD=Admin@123
